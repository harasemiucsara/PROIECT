<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidenta Produse"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0FF">

    <StackPanel Margin="30">

        <!-- Titlu aplicatie -->
        <Label Content="EVIDENTA PRODUSE"
               FontSize="22" FontWeight="Bold"
               Foreground="#6B21A8"
               HorizontalAlignment="Center"/>

        <Label Content="Harasemiuc Sara  ·  PIU  ·  Lab 7"
               FontSize="12" FontStyle="Italic"
               Foreground="#9CA3AF"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

        <!-- Sectiunea de introducere date -->
        <Label Content="Nume produs:"
               FontSize="13" Foreground="#374151"/>

        <TextBox x:Name="txtNumeProdus"
                 FontSize="13"
                 Padding="6"
                 Margin="0,0,0,10"/>

        <Label Content="Pret produs (lei):"
               FontSize="13" Foreground="#374151"/>

        <TextBox x:Name="txtPretProdus"
                 FontSize="13"
                 Padding="6"
                 Margin="0,0,0,16"/>

        <!-- Buton pentru afisare -->
        <Button Content="Afiseaza Produs"
                FontSize="13" FontWeight="Bold"
                Background="#7C3AED" Foreground="White"
                Padding="10,8"
                Margin="0,0,0,20"
                Click="BtnAfiseaza_Click"/>

        <!-- Zona de afisare rezultat -->
        <Label Content="Rezultat:"
               FontSize="13" FontWeight="Bold"
               Foreground="#6B21A8"/>

        <TextBlock x:Name="txtRezultat"
                   FontSize="13"
                   Foreground="#1F2937"
                   TextWrapping="Wrap"
                   Margin="4,4,0,0"/>

    </StackPanel>

</Window>
