<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidenta Produse - Harasemiuc Sara"
        Height="600" Width="750"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0FF">

    <!-- BONUS: Stiluri comune definite in Window.Resources -->
    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="BorderBrush" Value="#A78BFA"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <!-- Stil special pentru titlurile de sectiune -->
        <Style x:Key="TitluSectiune" TargetType="Label">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B21A8"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Meniu -->
            <RowDefinition Height="Auto"/>  <!-- Titlu -->
            <RowDefinition Height="*"/>     <!-- Continut principal -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===================== MENIU ===================== -->
        <Menu Grid.Row="0" Background="#EDE9FE" FontSize="13">
            <MenuItem Header="Fisier">
                <MenuItem Header="Nou" Click="MenuNou_Click"/>
                <Separator/>
                <MenuItem Header="Iesire" Click="MenuIesire_Click"/>
            </MenuItem>
            <MenuItem Header="Ajutor">
                <MenuItem Header="Despre aplicatie" Click="MenuDespre_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===================== TITLU ===================== -->
        <StackPanel Grid.Row="1" Background="#7C3AED" Margin="0">
            <Label Content="EVIDENTA PRODUSE"
                   FontSize="20" FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Padding="10,8"/>
        </StackPanel>

        <!-- ===================== CONTINUT PRINCIPAL (Grid responsive) ===================== -->
        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- Coloana stanga -->
                <ColumnDefinition Width="14"/>  <!-- Spatiu intre coloane -->
                <ColumnDefinition Width="*"/>   <!-- Coloana dreapta -->
            </Grid.ColumnDefinitions>

            <!-- ===== COLOANA STANGA: Adaugare produs ===== -->
            <StackPanel Grid.Column="0">

                <Label Content="Adaugare Produs" Style="{StaticResource TitluSectiune}"/>

                <Label Content="Nume produs:"/>
                <TextBox x:Name="txtNume"/>

                <Label Content="Pret (lei):"/>
                <TextBox x:Name="txtPret"/>

                <Label Content="Cantitate:"/>
                <TextBox x:Name="txtCantitate"/>

                <!-- RadioButton pentru Categorie -->
                <Label Content="Categorie:" Margin="0,6,0,0"/>
                <RadioButton x:Name="rbSuplimente" Content="Suplimente"   GroupName="Categorie" IsChecked="True"/>
                <RadioButton x:Name="rbAlimente"   Content="Alimente"     GroupName="Categorie"/>
                <RadioButton x:Name="rbCosmetica"  Content="Cosmetica"    GroupName="Categorie"/>
                <RadioButton x:Name="rbIngrijire"  Content="Produse Ingrijire" GroupName="Categorie"/>

                <!-- CheckBox pentru Optiuni -->
                <Label Content="Optiuni speciale:" Margin="0,8,0,0"/>
                <CheckBox x:Name="chkProdusNou"  Content="Produs Nou"/>
                <CheckBox x:Name="chkOferta"     Content="Oferta"/>
                <CheckBox x:Name="chkResigilat"  Content="Resigilat"/>
                <CheckBox x:Name="chkCadou"      Content="Produs Cadou"/>

                <Button Content="Adauga Produs" Click="BtnAdauga_Click"/>

                <!-- Mesaj dupa adaugare -->
                <TextBlock x:Name="txtMesajAdaugare"
                           FontSize="12" Foreground="#059669"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>

            </StackPanel>

            <!-- ===== COLOANA DREAPTA: Cautare produs ===== -->
            <StackPanel Grid.Column="2">

                <Label Content="Cautare Produs" Style="{StaticResource TitluSectiune}"/>

                <Label Content="Cauta dupa nume:"/>
                <TextBox x:Name="txtCautare"/>

                <Button Content="Cauta" Click="BtnCauta_Click"/>

                <Label Content="Rezultat cautare:" Margin="0,16,0,0"/>
                <TextBlock x:Name="txtRezultatCautare"
                           FontSize="13" Foreground="#1F2937"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           LineHeight="22"/>

            </StackPanel>
        </Grid>

        <!-- ===================== STATUS BAR ===================== -->
        <StatusBar Grid.Row="3" Background="#EDE9FE">
            <TextBlock x:Name="txtStatus"
                       Text="Gata. Introduceti datele unui produs."
                       FontSize="11" Foreground="#6B21A8"/>
        </StatusBar>

    </Grid>
</Window>
