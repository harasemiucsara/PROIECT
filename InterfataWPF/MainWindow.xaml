<Window x:Class="InterfataWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidenta Produse - Harasemiuc Sara"
        Height="640" Width="820"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0FF">

    <!-- BONUS: Stiluri comune definite in Window.Resources -->
    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="BorderBrush" Value="#A78BFA"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>

        <!-- Stil special pentru titlurile de sectiune -->
        <Style x:Key="TitluSectiune" TargetType="Label">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B21A8"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Meniu -->
            <RowDefinition Height="Auto"/>  <!-- Titlu -->
            <RowDefinition Height="*"/>     <!-- Continut principal -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===================== MENIU ===================== -->
        <Menu Grid.Row="0" Background="#EDE9FE" FontSize="13">
            <MenuItem Header="Fisier">
                <MenuItem Header="Nou" Click="MenuNou_Click"/>
                <Separator/>
                <MenuItem Header="Iesire" Click="MenuIesire_Click"/>
            </MenuItem>
            <MenuItem Header="Ajutor">
                <MenuItem Header="Despre aplicatie" Click="MenuDespre_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===================== TITLU ===================== -->
        <StackPanel Grid.Row="1" Background="#7C3AED">
            <Label Content="EVIDENTA PRODUSE"
                   FontSize="20" FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Padding="10,8"/>
        </StackPanel>

        <!-- ===================== CONTINUT PRINCIPAL (Grid responsive) ===================== -->
        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- Coloana stanga: formular -->
                <ColumnDefinition Width="14"/>  <!-- Spatiu -->
                <ColumnDefinition Width="*"/>   <!-- Coloana dreapta: lista + cautare -->
            </Grid.ColumnDefinitions>

            <!-- ===== COLOANA STANGA: Adaugare produs ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Label Content="Adaugare Produs" Style="{StaticResource TitluSectiune}"/>

                    <Label Content="Nume produs:"/>
                    <TextBox x:Name="txtNume"/>

                    <Label Content="Pret (lei):"/>
                    <TextBox x:Name="txtPret"/>

                    <Label Content="Cantitate:"/>
                    <TextBox x:Name="txtCantitate"/>

                    <!-- DatePicker pentru data expirarii -->
                    <Label Content="Data expirarii:"/>
                    <DatePicker x:Name="dpDataExpirarii"
                                FontSize="13"
                                Margin="0,2,0,6"/>

                    <!-- Categorie si Optiuni speciale side-by-side -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RadioButton pentru Categorie -->
                        <StackPanel Grid.Column="0">
                            <Label Content="Categorie:"/>
                            <RadioButton x:Name="rbSuplimente" Content="Suplimente"        GroupName="Categorie" IsChecked="True"/>
                            <RadioButton x:Name="rbAlimente"   Content="Alimente"          GroupName="Categorie"/>
                            <RadioButton x:Name="rbCosmetica"  Content="Cosmetica"         GroupName="Categorie"/>
                            <RadioButton x:Name="rbIngrijire"  Content="Produse Ingrijire" GroupName="Categorie"/>
                        </StackPanel>

                        <!-- CheckBox pentru Optiuni speciale -->
                        <StackPanel Grid.Column="2">
                            <Label Content="Optiuni speciale:"/>
                            <CheckBox x:Name="chkProdusNou" Content="Produs Nou"/>
                            <CheckBox x:Name="chkOferta"    Content="Oferta"/>
                            <CheckBox x:Name="chkResigilat" Content="Resigilat"/>
                            <CheckBox x:Name="chkCadou"     Content="Produs Cadou"/>
                        </StackPanel>
                    </Grid>

                    <!-- Butoane Adauga si Reset -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Adauga Produs" Click="BtnAdauga_Click"/>
                        <Button Grid.Column="2" Content="Reseteaza" Click="MenuNou_Click"/>
                    </Grid>

                    <TextBlock x:Name="txtMesajAdaugare"
                               FontSize="12" Foreground="#059669"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== COLOANA DREAPTA: Lista + Filtru + Cautare ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Titlu lista -->
                    <RowDefinition Height="*"/>     <!-- ListBox -->
                    <RowDefinition Height="Auto"/>  <!-- ComboBox filtru -->
                    <RowDefinition Height="Auto"/>  <!-- Cautare -->
                </Grid.RowDefinitions>

                <!-- Lista produse adaugate -->
                <Label Grid.Row="0"
                       Content="Lista Produse Adaugate"
                       Style="{StaticResource TitluSectiune}"/>

                <!-- ListBox care afiseaza produsele adaugate -->
                <ListBox Grid.Row="1"
                         x:Name="listBoxProduse"
                         FontSize="12"
                         Margin="0,0,0,8"
                         BorderBrush="#A78BFA"/>

                <!-- ComboBox pentru filtrare dupa categorie -->
                <StackPanel Grid.Row="2">
                    <Label Content="Filtreaza dupa categorie:"/>
                    <ComboBox x:Name="cmbFiltruCategorie"
                              SelectionChanged="CmbFiltru_SelectionChanged">
                        <ComboBoxItem Content="Toate" IsSelected="True"/>
                        <ComboBoxItem Content="Suplimente"/>
                        <ComboBoxItem Content="Alimente"/>
                        <ComboBoxItem Content="Cosmetica"/>
                        <ComboBoxItem Content="Produse Ingrijire"/>
                    </ComboBox>
                </StackPanel>

                <!-- Cautare dupa nume -->
                <StackPanel Grid.Row="3">
                    <Label Content="Cauta dupa nume:" Margin="0,6,0,0"/>
                    <TextBox x:Name="txtCautare"/>
                    <Button Content="Cauta" Click="BtnCauta_Click"/>
                    <TextBlock x:Name="txtRezultatCautare"
                               FontSize="12" Foreground="#1F2937"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" LineHeight="20"/>
                </StackPanel>

            </Grid>
        </Grid>

        <!-- ===================== STATUS BAR ===================== -->
        <StatusBar Grid.Row="3" Background="#EDE9FE">
            <TextBlock x:Name="txtStatus"
                       Text="Gata. Introduceti datele unui produs."
                       FontSize="11" Foreground="#6B21A8"/>
        </StatusBar>

    </Grid>
</Window>
